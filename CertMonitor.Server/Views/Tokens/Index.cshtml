@model IReadOnlyList<TokenListItemViewModel>
@{
    ViewData["Title"] = "Tokens";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Tokens</h1>
        <p class="text-muted mb-0">Список найденных Rutoken-носителей.</p>
    </div>
    <span class="badge bg-primary-subtle text-primary-emphasis rounded-pill">@Model.Count</span>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Serial Number</th>
                    <th>Token Type</th>
                    <th>Model</th>
                    <th>Manufacturer</th>
                    <th>PKCS11 Slot Id</th>
                    <th>Workstation Hostname</th>
                    <th>Last Seen</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">Данных пока нет.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.SerialNumber</td>
                        <td>@item.TokenType</td>
                        <td>@item.Model</td>
                        <td>@item.Manufacturer</td>
                        <td>@item.Pkcs11SlotId</td>
                        <td>@item.WorkstationHostname</td>
                        <td>@item.LastSeenAtUtc.ToString("u")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
