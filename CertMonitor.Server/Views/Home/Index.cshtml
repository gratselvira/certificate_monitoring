@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4 gap-3">
    <div>
        <h1 class="h3 mb-1">Dashboard</h1>
        <p class="text-muted mb-0">Последние данные, принятые от CertMonitor.Agent.</p>
    </div>
    <div class="text-muted">
        Последний hostname:
        <strong>@(Model.LatestHostname ?? "нет данных")</strong>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <div class="text-muted small mb-2">Последнее сканирование</div>
                <div class="fs-5 fw-semibold">@(Model.LastScanAtUtc?.ToString("u") ?? "нет данных")</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <div class="text-muted small mb-2">Токены</div>
                <div class="display-6 fw-semibold">@Model.TokensCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <div class="text-muted small mb-2">Сертификаты</div>
                <div class="display-6 fw-semibold">@Model.CertificatesCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <div class="text-muted small mb-2">Scan sessions</div>
                <div class="display-6 fw-semibold">@Model.ScanSessionsCount</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="h5 mb-3">Переходы</h2>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" asp-controller="Tokens" asp-action="Index">Открыть Tokens</a>
            <a class="btn btn-outline-primary" asp-controller="Certificates" asp-action="Index">Открыть Certificates</a>
            <a class="btn btn-outline-primary" asp-controller="ScanSessions" asp-action="Index">Открыть Scan Sessions</a>
        </div>
    </div>
</div>
