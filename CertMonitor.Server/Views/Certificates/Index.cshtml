@model IReadOnlyList<CertificateListItemViewModel>
@{
    ViewData["Title"] = "Сертификаты";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Сертификаты</h1>
        <p class="text-muted mb-0">Список сертификатов, принятых от агента.</p>
    </div>
    <span class="badge bg-primary-subtle text-primary-emphasis rounded-pill">@Model.Count</span>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Владелец (Subject)</th>
                    <th>Издатель (Issuer)</th>
                    <th>Серийный номер</th>
                    <th>Отпечаток</th>
                    <th>Действует с</th>
                    <th>Действует до</th>
                    <th>Алгоритм</th>
                    <th>Серийный номер токена</th>
                    <th>Последнее обнаружение</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">Данных пока нет.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Subject</td>
                        <td>@item.Issuer</td>
                        <td>@item.SerialNumber</td>
                        <td class="text-break">@(!string.IsNullOrWhiteSpace(item.Thumbprint) ? item.Thumbprint : "-")</td>
                        <td>@item.ValidFromUtc.ToString("u")</td>
                        <td>@item.ValidToUtc.ToString("u")</td>
                        <td>@item.Algorithm</td>
                        <td>@(!string.IsNullOrWhiteSpace(item.TokenSerialNumber) ? item.TokenSerialNumber : "-")</td>
                        <td>@item.LastSeenAtUtc.ToString("u")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
